; CALL SelectorSelectTile
; de index of the tile 'spot' selected is in address (SELECTORPOS)

    .section .text
    .global SelectorSelectTile
    
    .include "Macros.asc"

SelectorSelectTile:
    SetVDP 15, 0                   ; Kijk naar Status register 0
    ld b,1

.Waitloop:                         ; Wait on V-Blank (Synchronize)
    in a,(VDPC)                    ; Wacht nu tot hij weer 0 is
    rlca
    jp nc, .Waitloop
    dec b
    jp nz, .Waitloop

    GetActionKeys                  ; A contains bitmask (ABC broken)
                                   ; bit   7    6    5    4    3       2     1    0
                                   ;       →	↓	 ↑    ←  return   tab   esc space
    bit 7, A
    jr NZ, right
    bit 6, A
    jr NZ, down
    bit 5, A
    jr NZ, up
    bit 4, A
    jr NZ, left
    bit 0, A
    ret NZ                         ; choosen spacebar, so we got one selected.
    inc b
    jr .Waitloop

right:
    ld b, 1
    jr moveSelector

down:
    ld b, 3
    jr moveSelector

up:
    ld b, 2
    jr moveSelector

left:
    ld b,0
    jr moveSelector

moveSelector:
    CALL SelectorNewPos            ; 0 left, 1 right, 2 up, 3 down
    ld b, 10
    jr z, .Waitloop

    CALL SelectorShow
    ld b, 10                       ; slow down the keystroke-repeat.
    jr .Waitloop