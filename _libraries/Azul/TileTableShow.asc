
    .section .text
    .global TileTableShow

    .include "Macros.asc"
    

TileTableShow:
    ; Show amount of table tiles
    ld b, 5
loop_table:
    push bc
    call Waitvdp
    ld HL, TILESONTABLEPOSITIONS
    ld C, b
    dec c
    ld b, 0
    add HL, bc
    add HL, bc                     ; hL is now the address right place on table
    ld D, (HL)
    inc HL
    ld E, (HL)

    ld a, 12                       ; write a 0 next to it.
    add a, d
    ld d, a

    ld hl, TILESONTABLE            ; get the nr to write
    add hl, bc
    ld a, (hl)


    call ScoreNumber               ; A = number (0-9) DE = location (x,y) (stays intact)
    pop bc
    djnz loop_table
    ret