;; CALL SelectorNewPos
;; IN:  B = direction: 0 left, 1 right, 2 up, 3 down
;; OUT: A = new index position,  ( A = 0xff and Z flag set if not moved.)

    .section .text
    .global SelectorNewPos

SelectorNewPos:                    
    ld a, (SELECTORPOS)
    add a, a
    add a, a                       ; a is index op SELECTORMOVEMENT
    add a, b
    
    ld HL, SELECTORMOVEMENT
    ld c, a
    ld b, 0
    add HL, bc

    ld a, (HL)                     ; a = new spot (0xFF if not possible)
    cp 0xFF
    ret z

    ld (SELECTORPOS), a
    ret
