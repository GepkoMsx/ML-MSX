    .section .data
    .global FACTORYPOSITIONS, TILESONTABLEPOSITIONS, HANDPOSITIONS
    .global PATTERNLINEPOSITIONS, PATTERNSELECTORPOSITIONS, FLOORLINEPOSITIONS

FACTORYPOSITIONS:
    .byte 48,45                    ; x,y for every tile on a factory (20 places)
    .byte 48+12, 45                ; 1 2
    .byte 48, 45+12                ; 3 4 pattern
    .byte 48+12, 45+12

    .byte 12,84
    .byte 12+12,84
    .byte 12,84+12
    .byte 12+12,84+12

    .byte 92,84
    .byte 92+12,84
    .byte 92,84+12
    .byte 92+12,84+12

    .byte 12,127
    .byte 12+12,127
    .byte 12,127+12
    .byte 12+12,127+12
    
    .byte 92,127
    .byte 92+12,127
    .byte 92,127+12
    .byte 92+12,127+12

TILESONTABLEPOSITIONS:             ; 6 tiles in a column in the middle
    .byte 50,84                    ; the 5 colors and start-tile.
    .byte 50,84+12                 ; next to it, a number counting the amount.
    .byte 50,84+24
    .byte 50,84+36
    .byte 50,84+48
    .byte 50+6,84+60               ; starttile.

HANDPOSITIONS:                     ; 20 hand tiles in two rows at the bottom left
    .byte 0,176, 12,176, 24,176, 36,176, 48,176
    .byte 60,176, 72,176, 84,176, 96,176, 108,176
    .byte 0,192, 12,192, 24,192, 36,192, 48,192
    .byte 60,192, 72,192, 84,192, 96,192, 108,192

PATTERNLINEPOSITIONS:              ; Player 1, right-to-left within each line
    .byte 176,21                   ; line 1 at the top, line 5 at the bottom
    .byte 164,33, 176,33
    .byte 152,45, 164,45, 176,45
    .byte 140,57, 152,57, 164,57, 176,57
    .byte 128,69, 140,69, 152,69, 164,69, 176,69
                                    ; Player 2 board is 106 pixels below player 1
    .byte 176,127
    .byte 164,139, 176,139
    .byte 152,151, 164,151, 176,151
    .byte 140,163, 152,163, 164,163, 176,163
    .byte 128,175, 140,175, 152,175, 164,175, 176,175

PATTERNSELECTORPOSITIONS:          ; right end of each pattern line, both players
    .byte 175,23, 175,35, 175,47, 175,59, 175,71
    .byte 175,129, 175,141, 175,153, 175,165, 175,177

FLOORLINEPOSITIONS:                ; left-to-right, seven spaces per player
    .byte 145,92,  158,92,  173,92,  187,92,  201,92,  215,92,  229,92
    .byte 145,198, 158,198, 173,198, 187,198, 201,198, 215,198, 229,198
