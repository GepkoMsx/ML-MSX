    .section .data
    .global FACTORYPOSITIONS, TILESONTABLEPOSITIONS, TILESWALL1POSITIONS, TILESWALL2POSITIONS

FACTORYPOSITIONS:
    .byte 48,45                    ; x,y for every tile on a factory (20 places)
    .byte 48+12, 45                ; 1 2
    .byte 48, 45+12                ; 3 4 pattern
    .byte 48+12, 45+12

    .byte 12,84
    .byte 12+12,84
    .byte 12,84+12
    .byte 12+12,84+12

    .byte 92,84
    .byte 92+12,84
    .byte 92,84+12
    .byte 92+12,84+12

    .byte 12,127
    .byte 12+12,127
    .byte 12,127+12
    .byte 12+12,127+12
    
    .byte 92,127
    .byte 92+12,127
    .byte 92,127+12
    .byte 92+12,127+12

TILESONTABLEPOSITIONS:             ; 6 tiles in a column in the middle
    .byte 50,84                    ; the 5 colors and start-tile.
    .byte 50,84+12                 ; next to it, a number counting the amount.
    .byte 50,84+24
    .byte 50,84+36
    .byte 50,84+48
    .byte 50+6,84+60               ; starttile.

TILESWALL1POSITIONS:               ; 5 right most tiles at the wall for player 1
    .byte 00,00                    ; TODO!
    .byte 00,00
    .byte 00,00
    .byte 00,00
    .byte 00,00

TILESWALL2POSITIONS:               ; 5 right most tiles at the wall for player 2
    .byte 00,00                    ; TODO!
    .byte 00,00
    .byte 00,00
    .byte 00,00
    .byte 00,00

