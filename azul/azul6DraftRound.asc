;; ==[ Azul6DraftRound ]====================================================
;;
    .section .text
    .global Azul6DraftRound

    .include "Macros.asc"

Azul6DraftRound:
.draftTurn:
    call .hasDraftTiles
    or a
    ret z

    call SelectorShow              ; Redraw the selector (tile animations hide it and change its color).
    call Azul6_1FactorySupply      ; Keep asking this player until a non-empty source is chosen.
    ld a, (SELECTEDTILE+1)
    or a
    jr z, .draftTurn

    call Azul6_2PlaceOnPatternLine ; Place this player's selected tiles before changing turns.
    ld a, (CURRENTPLAYER)
    xor 1
    ld (CURRENTPLAYER), a
    jr .draftTurn

.hasDraftTiles:
    ld HL, TILESINFACTORY          ; Any non-FF factory slot means tiles remain to be drafted.
    ld b, 20
.factoryCheck:
    ld a, (HL)
    cp 0xFF
    jr nz, .tilesRemain
    inc HL
    djnz .factoryCheck

    ld HL, TILESONTABLE            ; Center counts determine whether another draft is possible.
    ld b, 5
.centerCheck:
    ld a, (HL)
    or a
    jr nz, .tilesRemain
    inc HL
    djnz .centerCheck

    xor a                          ; No factory or center tiles remain; this round's draft is complete.
    ret

.tilesRemain:
    ld a, 1
    ret
