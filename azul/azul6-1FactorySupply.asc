;; ==[ Azul6-1FactorySupply ]================================================
;;
    .section .text
    .global Azul6_1FactorySupply

    .include "Macros.asc"

Azul6_1FactorySupply:
    xor a
    ld (HANDINDEX), a
    ld (TAKEFROMCENTER), a
    ld (SELECTEDTILE+1), a
    call SelectorSelectTile        ; SELECTORPOS contains the selected position

    ld a, (SELECTORPOS)
    cp 20
    jp nc, .fromTable

    ld c, a                        ; C = the factory spot under the selector
    ld b, 0
    ld HL, TILESINFACTORY
    add HL, bc
    ld a, (HL)
    cp 5
    ret nc                         ; ignore an empty factory position

    ld (SELECTEDTILE), a           ; the color of the selected spot is the color we take
    ld (CURRENTTYPE), a
    ld a, c
    and 0b11111100                 ; first spot of that factory
    ld (FACTORYINDEX), a
    xor a
    ld (SELECTEDTILE+1), a
    ld a, 4
    ld (FACTORYLEFT), a
    ld a, (FACTORYINDEX)
    ld (FACTORYSTART), a
    ld a, 1
    ld (FACTORYPASS), a

.factoryLoop:
    ld a, (FACTORYINDEX)
    ld c, a
    ld b, 0
    ld HL, TILESINFACTORY
    add HL, bc
    ld a, (HL)
    cp 0xFF
    jr z, .nextFactoryTile

    ld c, a
    ld a, (SELECTEDTILE)
    cp c
    jr z, .toHand
    ld a, (FACTORYPASS)
    cp 1
    jr z, .nextFactoryTile

.toTable:
    ld a, c
    ld (CURRENTTYPE), a
    ld a, (FACTORYINDEX)
    call .getFactorySource
    ld (MOVESOURCE), hl
    ld a, (CURRENTTYPE)
    add a, a
    ld c, a
    ld b, 0
    ld HL, TILESONTABLEPOSITIONS
    add HL, bc
    ld d, (HL)
    inc HL
    ld e, (HL)
    ld a, (CURRENTTYPE)
    ld b, a
    ld HL, (MOVESOURCE)
    call .moveTile
    call .clearMoveSource

    ld a, (CURRENTTYPE)
    ld c, a
    ld b, 0
    ld HL, TILESONTABLE
    add HL, bc
    inc (HL)
    jr .emptyFactoryTile

.toHand:
    ld a, (FACTORYPASS)
    cp 1
    jr nz, .nextFactoryTile
    ld a, (FACTORYINDEX)
    call .getFactorySource
    ld (MOVESOURCE), hl
    call .getHandDestination
    ld HL, (MOVESOURCE)
    ld a, (SELECTEDTILE)
    ld b, a
    call .moveTile
    call .clearMoveSource

    ld HL, SELECTEDTILE+1
    inc (HL)
    ld a, (HANDINDEX)
    inc a
    ld (HANDINDEX), a

.emptyFactoryTile:
    ld a, (FACTORYINDEX)
    ld c, a
    ld b, 0
    ld HL, TILESINFACTORY
    add HL, bc
    ld (HL), 0xFF

.nextFactoryTile:
    ld a, (FACTORYINDEX)
    inc a
    ld (FACTORYINDEX), a
    ld a, (FACTORYLEFT)
    dec a
    ld (FACTORYLEFT), a
    jr z, .factoryPassComplete
    jp .factoryLoop

.factoryPassComplete:
    ld a, (FACTORYPASS)
    cp 1
    jr nz, .factoryComplete
    ld a, 2
    ld (FACTORYPASS), a
    ld a, (FACTORYSTART)
    ld (FACTORYINDEX), a
    ld a, 4
    ld (FACTORYLEFT), a
    jp .factoryLoop

.factoryComplete:
    call TileTableShow
    ret

.fromTable:
    sub 20
    cp 5
    ret nc

    ld (SELECTEDTILE), a
    ld (CURRENTTYPE), a
    ld c, a
    ld b, 0
    ld HL, TILESONTABLE
    add HL, bc
    ld a, (HL)
    ld (SELECTEDTILE+1), a
    or a
    ret z
    ld a, 1
    ld (TAKEFROMCENTER), a
    xor a
    ld (HANDINDEX), a
    ld a, (SELECTEDTILE+1)
    ld (TABLELEFT), a

    ld a, (CURRENTTYPE)
    add a, a
    ld c, a
    ld b, 0
    ld HL, TILESONTABLEPOSITIONS
    add HL, bc
    ld d, (HL)
    inc HL
    ld e, (HL)
    ex de, hl
    ld (MOVESOURCE), hl

.tableLoop:
    ld HL, (MOVESOURCE)
    call .getHandDestination
    ld HL, (MOVESOURCE)
    ld a, (SELECTEDTILE)
    ld b, a
    call .moveTile

    ld a, (HANDINDEX)
    inc a
    ld (HANDINDEX), a
    ld a, (TABLELEFT)
    dec a
    ld (TABLELEFT), a
    jr nz, .tableLoop              ; the colored placeholder on the table stays visible

    ld a, (CURRENTTYPE)
    ld c, a
    ld b, 0
    ld HL, TILESONTABLE
    add HL, bc
    ld (HL), 0
    call TileTableShow
    ret

.getFactorySource:
    add a, a
    ld c, a
    ld b, 0
    ld HL, FACTORYPOSITIONS
    add HL, bc
    ld d, (HL)
    inc HL
    ld e, (HL)
    ex de, hl
    ret

.getHandDestination:
    ld a, (HANDINDEX)
    add a, a
    ld c, a
    ld b, 0
    ld HL, HANDPOSITIONS
    add HL, bc
    ld d, (HL)
    inc HL
    ld e, (HL)
    ret

.moveTile:
    ld (MOVESOURCE), hl
    ld (MOVEDESTINATION), de
    ld a, b
    ld (MOVETYPE), a
    ld c, a
    call FactoryTakeFromBag
    call Waitvdp
    ld a, (MOVETYPE)
    ld c, a
    ld de, (MOVEDESTINATION)
    call TileShow
    call Waitvdp
    SetLastSprite16 0
    ret

.clearMoveSource:
    call Waitvdp
    ld HL, (MOVESOURCE)
    ld d, h
    ld e, l
    ld c, 8                        ; blank tile in tiles.rl5
    call TileShow
    call Waitvdp
    ret

    .section .data
    .global SELECTEDTILE, HANDINDEX, TAKEFROMCENTER

SELECTEDTILE:
    .byte 0, 0                     ; selected type and number of tiles
FACTORYINDEX:
    .byte 0
FACTORYSTART:
    .byte 0
FACTORYPASS:
    .byte 0
FACTORYLEFT:
    .byte 0
HANDINDEX:
    .byte 0
TAKEFROMCENTER:
    .byte 0
CURRENTTYPE:
    .byte 0
TABLELEFT:
    .byte 0
MOVETYPE:
    .byte 0
MOVESOURCE:
    .word 0
MOVEDESTINATION:
    .word 0
