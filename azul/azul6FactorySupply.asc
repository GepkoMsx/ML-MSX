;; ==[ Azul6FactorySupply ]==================================================
;;
    .section .text
    .global Azul6FactorySupply

    .include "Macros.asc"

Azul6FactorySupply:

    CALL SelectorSelectTile        ; (SELECTORPOS) contains the index-postition

    ; now sort the tiles we selected. 
    ld a, (SELECTORPOS)            ; 0-19 are a factory, 20+ are table.
    ld HL, TILESINFACTORY
    ld c, a
    ld b, 0
    add HL, bc
    cp 20                          ; a >= 20?
    jr  NC, fromTable

;; FROMFACTORY
fromFactory:
    and 0b11111100                 ; shift position to first tile in factory
    ld b, a                        ; save the postition (b)
    ld a, (HL)
    ld (SELECTEDTILE), a           ; the type
    ld c, a                        ; save the type (c)

    ld HL, TILESINFACTORY
    ld e, b
    ld d, 0
    add hl, de                     ; hl points to 1st spot in factory
    ld b, 4                        ; check the 4 tiles
    ld d, 0                        ; d = amount
loop:
    ld a, (HL)
    cp c                           ; same tiletype?
    jr nz, notsame

same:
    inc d
    ; todo: animate to hand?
    jr loopcont

notsame:
    ; todo: move other factory tile to "table"

loopcont:
    inc HL
    djnz loop

    ld a, d                        ; amount the same
    ld (SELECTEDTILE+1), a         ; save it.


    jr continue

;; FROMTABLE
fromTable:
    ld b, 20                       ; type is index-20
    sub b
    ld (SELECTEDTILE), a
    ld b, a                        ; save type

    ld a, (HL)                     ; amount is at index
    ld (SELECTEDTILE+1), a         ; save amount

    ; todo: animate [a] tiles of type [b] to hand?

continue:
    ; SELECTEDTILE is filled correctly now.
    ret                            ; TODO: finsih rest

    ; select a location on board
    ; move the selected tiles from hand to board, and overflow to floodline




; -DONE- We can choose a tile from a factory or middle of table.
;
; we take all tiles of same type
; if it was a factory, other types on factory goto table.
; if you are the first taking from table, take the 1st player tile to floodline

; taken tiles must be put on a line (right to left)
; if tiles already there, type must match
; can't have 2 rows of same type.
; remaining tiles goto floodline

; repeat rotating players
; this phase is done when all factories and table are gone.

; functions needed
; - use selector to choose a tile from factory or table.
;   - cursorkeys to move (FACTORYPOSITIONS (inculdes tilesontable) and SELECTORMOVEMENT)
; - highlight that tile
; - use select to choose a line to put the tiles.
; - move 1stplayer tile
; - keep track of lines and floodline
; - comptuter AI
; - manage table??


    .section .data
    .global SELECTEDTILE

SELECTEDTILE:
    .byte 0, 0                     ; type, amount

